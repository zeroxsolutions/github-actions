<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A template: install.sh substitutes each __PLACEHOLDER__ and writes one copy per slot. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <!-- The slot number is the argument: it picks that slot's own mise volume. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROGRAM__</string>
    <string>__SLOT__</string>
  </array>

  <!-- The whole supervisor: the script exits after one job, and launchd starts it again. -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>

  <!-- `docker` is not on launchd's default PATH, which is /usr/bin:/bin:/usr/sbin:/sbin. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
